---
// --- Types ---
interface Props {
  alt?: boolean;
  name: string;
  title: string;
  url: string;
  re: RegExp;
}

// --- Injects ---
const { alt = false, name, title, url, re } = Astro.props;
---

<a
  class:list={[
    alt
      ? ":uno: flex gap-2 transition-colors items-baseline hover:text-sky-400"
      : ":uno: flex flex-col transition-colors items-start hover:text-sky-400",
    re.test(Astro.url.pathname) ? "text-sky-400" : "text-white",
  ]}
  href={url}
>
  <span class={alt ? "text-xl" : ":uno: text-lg leading-none"}>{title}</span>
  <span class={(!alt && "text-sm") || null}>{name}</span>
</a>
