---
import type { HTMLAttributes } from "astro/types";

// --- Types ---
type Props = HTMLAttributes<"a">;

// --- Injects ---
const { class: klass, ...rests } = Astro.props;
---

<a
  class:list={[
    ":uno: text-blue-500 transition-colors hover:text-red-500",
    klass,
  ]}
  rel="noopener noreferer"
  target="_blank"
  {...rests}><slot /></a
>
