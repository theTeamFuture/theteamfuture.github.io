---
// --- Fonts ---
import { css as spaceport } from "@/assets/fonts/Spaceport_2006.otf";

// --- Components ---
import HazardArea from "./HazardArea.astro";

// --- Types ---
interface Props {
  variant?: "default" | "compact";
}

// --- Injects ---
const { variant = "default" } = Astro.props;
---

<nav
  class:list={[
    variant === "default"
      ? ":uno: flex flex-col gap-8"
      : ":uno: flex gap-8 max-md:mt-4 md:(ml-8 pb-4 self-end)",
  ]}
  style={{ fontFamily: `'${spaceport.family}'` }}
>
  <button
    class=":uno: opacity-50 inline-flex gap-1 cursor-pointer transition-opacity items-center hover:opacity-100"
    id="btn-notifications"
    data-crt
  >
    <div
      class:list={[
        ":uno: i-mdi-bell-notification h-8 w-8",
        variant === "default" && "-translate-y-1",
      ]}
    >
    </div>
    {variant === "default" && <>Notifications</>}
  </button>

  <a
    class=":uno: opacity-50 inline-flex gap-1 transition-opacity items-center hover:opacity-100"
    href="/cat/database"
    data-crt
  >
    <div
      class:list={[
        ":uno: i-mdi-database-search h-8 w-8",
        variant === "default" && "-translate-y-1",
      ]}
    >
    </div>
    {variant === "default" && <>Database</>}
  </a>

  <div class=":uno: opacity-50 inline-flex gap-1 items-center relative">
    {
      variant === "default" ? (
        <div class=":uno: inline-flex gap-1 items-center" data-crt>
          <div class=":uno: i-mdi-box-variant-closed h-8 w-8 -translate-y-1" />
          Registry
        </div>
      ) : (
        <div data-crt>
          <div class=":uno: i-mdi-box-variant-closed h-8 w-8" />
        </div>
      )
    }
    <HazardArea
      class:list={[
        variant === "default"
          ? ":uno: opacity-50 h-12 w-300px translate-x-[-25%]"
          : ":uno: opacity-50 inset-0",
      ]}
    />
  </div>

  <div class=":uno: opacity-50 inline-flex gap-1 items-center relative">
    {
      variant === "default" ? (
        <div class=":uno: inline-flex gap-1 items-center" data-crt>
          <div class=":uno: i-mdi-done-all h-8 w-8 -translate-y-1" />
          Submission
        </div>
      ) : (
        <div data-crt>
          <div class=":uno: i-mdi-done-all h-8 w-8" />
        </div>
      )
    }
    <HazardArea
      class:list={[
        variant === "default"
          ? ":uno: opacity-50 h-12 w-300px translate-x-[-25%]"
          : ":uno: opacity-50 inset-0",
      ]}
    />
  </div>
</nav>

<script>
  import type { CDialog } from "@/components/cat/web/dialog-container";

  // --- On page load ---
  document.addEventListener("astro:page-load", () => {
    document
      .querySelector<HTMLButtonElement>("#btn-notifications")
      ?.addEventListener("click", () => {
        const dia = document.querySelector<CDialog>("#dialog-notifications");
        if (!dia) return;

        dia.open();
      });
  });
</script>
