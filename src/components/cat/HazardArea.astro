---
// --- Types ---
interface Props {
  class?: string;
}

// --- Injects ---
const { class: klass } = Astro.props;
---

<div
  class:list={[":uno: hazard-tape absolute grid place-items-center", klass]}
  data-crt
>
  <span
    class=":uno: hazard-tape__stripes inset-0 absolute overflow-hidden"
    data-crt></span>
</div>

<style lang="scss" is:global>
  @keyframes hazard-stripes {
    to {
      background-position-x: 6rem;
    }
  }

  .hazard-tape {
    --crt-drop-color: rgb(255 0 0 / var(--crt-drop-strength));

    &__stripes::before {
      --uno: "content-empty transform-skew-x--30deg absolute";

      animation: hazard-stripes 0.8s linear infinite;
      background: repeating-linear-gradient(
        to right,
        transparent 0 3rem,
        red 3rem 6rem
      );
      inset: -0% -100%;
    }
  }
</style>
