---
// --- Types ---
interface Props {
  class?: string;
}

// --- Injects ---
const { class: klass } = Astro.props;
---

<div class={"hazard-tape " + klass} data-crt>
  <span class="hazard-tape__stripes" data-crt></span>
</div>

<style lang="scss" is:global>
  @keyframes hazard-stripes {
    to {
      background-position-x: 6rem;
    }
  }

  .hazard-tape {
    --crt-drop-color: rgb(255 0 0 / var(--crt-drop-strength));
    --at-apply: "absolute grid place-items-center";

    &__stripes {
      --at-apply: "absolute inset-0 overflow-hidden";

      &::before {
        --at-apply: "absolute transform-skew-x--30deg";

        content: "";
        inset: -0% -100%;
        background: repeating-linear-gradient(
          to right,
          transparent 0 3rem,
          red 3rem 6rem
        );
        animation: hazard-stripes 0.8s linear infinite;
      }
    }
  }
</style>
