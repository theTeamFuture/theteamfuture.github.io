---
// --- Fonts ---
import { css as spaceport } from "@/assets/fonts/Spaceport_2006.otf";

// --- Components ---
import AudioPlayer from "../AudioPlayer.astro";
import DialogContainer from "../DialogContainer.astro";

// --- Types ---
interface Props {
  id: string;
}

// --- Injects ---
const { id } = Astro.props;
---

<DialogContainer {id} tag="c-query-result" closeable={false}>
  <div>
    <section id="querying" data-crt>
      <h2
        class=":uno: font-bold my-8 flex gap-2 justify-center"
        style={{ fontFamily: `'${spaceport.family}'` }}
      >
        <div
          class=":uno: border-2 border-l-transparent rounded-full h-5 w-5 animate-spin"
        >
        </div>Querying...
      </h2>
    </section>

    <section id="error">
      <h2
        class=":uno: text-red-500 font-bold my-8 text-center"
        id="error-content"
        style={{
          fontFamily: `'${spaceport.family}'`,
          "--crt-drop-color": "rgb(255 0 0 / var(--crt-drop-strength))",
        }}
        data-crt
      >
      </h2>
    </section>

    <section id="text" data-crt>
      <h2
        class=":uno: font-bold mb-1 flex gap-2"
        style={{ fontFamily: `'${spaceport.family}'` }}
      >
        Found Text
      </h2>
      <h3 class="text-sm" id="text-name"></h3>
      <div
        class=":uno: px-2 border-2 max-h-[calc(100vh-6.5rem)] overflow-y-auto"
      >
        <pre class=":uno: my-1 text-wrap" id="text-content"></pre>
      </div>
    </section>

    <section id="image" data-crt>
      <h2
        class=":uno: font-bold mb-1 flex gap-2"
        style={{ fontFamily: `'${spaceport.family}'` }}
      >
        Found Image
      </h2>
      <h3 class="text-sm" id="image-name"></h3>
      <img
        class=":uno: mx-auto border-2 max-h-[calc(100vh-6.5rem)]"
        id="image-el"
        loading="lazy"
      />
    </section>

    <section id="audio" data-crt>
      <h2
        class=":uno: font-bold mb-1 flex gap-2"
        style={{ fontFamily: `'${spaceport.family}'` }}
      >
        Found Audio
      </h2>
      <AudioPlayer />
    </section>

    <section id="blob" data-crt>
      <h2
        class=":uno: font-bold mb-1 flex gap-2"
        style={{ fontFamily: `'${spaceport.family}'` }}
      >
        Found Blob
      </h2>
      <p class=":uno: my-8 text-center" id="blob-name"></p>
    </section>
  </div>
</DialogContainer>
