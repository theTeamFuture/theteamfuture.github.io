---
import type { MarkdownLayoutProps } from "astro";
import dayjs from "dayjs";

// --- Layouts ---
import BaseLayout from "@/layouts/BaseLayout.astro";

// --- Components ---
import ArticleMeta from "@/components/ArticleMeta.astro";

// --- Types ---
type Props = MarkdownLayoutProps<{
  title: string;
  date: string;
  wordCount: number;
}>;

// --- Injects ---
const { frontmatter } = Astro.props;
---

<BaseLayout>
  <title slot="head-title">{`${frontmatter.title} - FUTURE 攻坚组`}</title>
  <Fragment slot="head-metas">
    <meta
      property="og:title"
      content={`${frontmatter.title} - FUTURE 攻坚组`}
    />
    <meta property="og:type" content="article" />
    <meta property="og:image" content="/favicon.svg" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:locale" content="zh-CN" />
    <meta property="og:site_name" content="FUTURE 攻坚组" />
    <meta
      property="article:published_time"
      content={dayjs(frontmatter.date).format()}
    />
    <meta name="twitter:card" content="summary" />
    <meta
      name="twitter:title"
      content={`${frontmatter.title} - FUTURE 攻坚组`}
    />
    <meta name="word_count" content={frontmatter.wordCount.toString()} />
    <slot name="head-metas" />
  </Fragment>
  <Fragment slot="head-links">
    <link
      href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css"
      rel="stylesheet"
    />
    <slot name="head-links" />
  </Fragment>

  <main class=":uno: mx-4 my-12 lg:mx-auto lg:min-w-3xl lg:w-1/2">
    <h1 class=":uno: text-3xl font-bold">{frontmatter.title}</h1>
    <ArticleMeta
      date={new Date(frontmatter.date)}
      wordCount={frontmatter.wordCount}
    />
    <article class=":uno: my-8 prose prose-invert max-w-unset!">
      <slot />
    </article>
  </main>
</BaseLayout>
