---
// --- Style sheets ---
import "@/styles/base.scss";

// --- Components ---
import { ClientRouter } from "astro:transitions";
import Loader from "@/components/Loader.astro";
import Preloader from "@/components/Preloader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeadScript from "@/components/SiteHeadScript.astro";
import SiteHeader from "@/components/SiteHeader.astro";

// --- Fonts ---
import { css as lxgw } from "@/assets/fonts/LXGWNeoXiHeiScreenFull.ttf";
import { css as emoji } from "@/assets/fonts/NotoColorEmoji_WindowsCompatible.ttf";

// --- Types ---
interface Props {
  empty?: boolean;
}

// --- Injects ---
const { empty = false } = Astro.props;

// --- Constants ---
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const fontFamily =
  [lxgw, emoji].map((s) => `'${s.family}'`).join() + ",var(--font-sans)";
---

<html class=":uno: scroll-smooth scroll-p-t-80px" lang="zh">
  <head>
    <!-- Title -->
    <slot name="head-title" />

    <!-- Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head-metas" />

    <!-- Links -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      !empty && (
        <link
          rel="stylesheet"
          href="https://cdn.jsdmirror.com/npm/aplayer/dist/APlayer.min.css"
        />
      )
    }
    <slot name="head-links" />

    <!-- Styles -->
    <slot name="head-styles" />

    <!-- Scripts -->
    {!empty && <SiteHeadScript />}
    <slot name="head-scripts" />

    <!-- View router -->
    {!empty && <ClientRouter />}
  </head>
  <body
    class=":uno: text-white bg-neutral-900 flex flex-col min-h-screen"
    style={{ fontFamily }}
  >
    {
      !empty && (
        <>
          {import.meta.env.PROD && <Preloader />}
          <Loader />
          <SiteHeader />
        </>
      )
    }
    <slot />
    {!empty && <SiteFooter />}
  </body>
</html>
