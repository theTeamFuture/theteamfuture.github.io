---
// --- Layouts ---
import BaseLayout from "@/layouts/cat/BaseLayout.astro";

// --- Components ---
import Navigation from "@/components/cat/Navigation.astro";
import SiteHeader from "@/components/cat/SiteHeader.astro";

// --- Fonts ---
import { css as spaceport } from "@/assets/fonts/Spaceport_2006.otf";
---

<BaseLayout>
  <title slot="head-title">Database - Chrono Agency Terminal</title>

  <div class=":uno: mx-4 my-8 lg:(mx-auto min-w-5xl w-1/2)">
    <div class=":uno: flex max-md:(flex-col items-center)">
      <SiteHeader />
      <Navigation variant="compact" />
    </div>
  </div>
  <hr class="border-t-2" data-crt />

  <main
    class=":uno: mx-4 my-8 lg:(mx-auto min-w-5xl w-1/2)"
    style={{ fontFamily: `'${spaceport.family}'` }}
    data-crt
  >
    <header class=":uno: text-2xl mb-8 flex gap-2 select-none items-center">
      <div class=":uno: i-mdi-database-search h-8 w-8 -translate-y-1"></div><h2>
        Database
      </h2>
    </header>
    <form id="form-database">
      <label class="mb-4">
        <b>Query Executor</b>
        <select class=":uno: px-2 py-1 outline-none border-2" name="executor">
          <option value="public">Public Document</option>
          <option value="classified">Classified Retriever</option>
          <option value="legacy">Legacy</option>
        </select>
      </label>

      <section id="s-public" style="display:flex">
        <label>
          <b>Document ID</b>
          <input name="s-public-id" type="text" required />
        </label>
      </section>

      <section id="s-classified">
        <label>
          <b>Document ID</b>
          <input name="s-classified-id" type="text" />
        </label>
        <label>
          <b>Password</b>
          <input name="s-classified-password" type="password" />
        </label>
      </section>

      <section id="s-legacy">
        <label>
          <b>Entry ID</b>
          <input name="s-legacy-id" type="text" />
        </label>
        <label>
          <b>Password</b>
          <input name="s-legacy-password" type="password" />
        </label>
      </section>

      <button type="submit">Query</button>
    </form>
  </main>
</BaseLayout>

<style lang="scss">
  a {
    --at-apply: "opacity-50 transition-opacity hover:opacity-100";
  }

  button {
    --at-apply: ":uno: px-2 py-1 border-2 border-white bg-white/0 cursor-pointer transition-color hover:(text-black bg-white)";
  }

  label {
    --at-apply: "flex flex-col py-2 items-start w-fit";
  }

  input {
    --at-apply: "outline-none border-2 px-2 py-1";
  }

  section {
    --at-apply: "mb-8 hidden flex flex-col";
  }

  td {
    --at-apply: "pl-4";
  }

  th {
    --at-apply: "text-left";
  }

  option {
    --at-apply: "text-black";
  }
</style>

<script>
  // @unocss-skip-start
  document.addEventListener("astro:page-load", () => {
    const form = document.querySelector<HTMLFormElement>("#form-database");
    if (!form) return;

    form
      .querySelector<HTMLSelectElement>("[name=executor]")
      ?.addEventListener("change", function () {
        form
          .querySelectorAll("section")
          .forEach((el) => (el.style.display = "none"));
        form.querySelectorAll("input").forEach((el) => {
          el.value = "";
          el.removeAttribute("required");
        });

        const sec = form.querySelector<HTMLDivElement>(
          `section#s-${this.value}`,
        );
        if (!sec) return;

        sec.style.display = "flex";
        sec
          .querySelectorAll("input")
          .forEach((el) => el.setAttribute("required", ""));
      });

    form.addEventListener("submit", (ev) => {
      ev.preventDefault();
      const data = new FormData(form);

      switch (data.get("executor")) {
        case "public":
        case "classified":
        case "legacy":
      }
    });
  });
  // @unocss-skip-end
</script>
