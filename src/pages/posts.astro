---
import { posts } from "@/utils/meta.server";
import dayjs from "dayjs";

// --- Layouts ---
import ArchiveLayout from "@/layouts/ArchiveLayout.astro";
---

<ArchiveLayout title="所有文章" total={posts.length}>
  {
    posts.map(({ data }) => (
      <a
        class=":uno: text-white p-4 border border-neutral-600 rounded-lg flex flex-col hover:(text-white bg-neutral-800)"
        href={`/posts/${data.slug}`}
        title={data.title}
      >
        <h1 class=":uno: text-lg font-bold">{data.title}</h1>
        <div class=":uno: text-xs text-neutral-500 flex gap-4 items-center">
          <div class=":uno: flex gap-1 items-center">
            <div class="i-mdi-calendar" />
            <span>{dayjs(data.published_at).format("YYYY/MM/DD")}</span>
          </div>
          {data.tags && (
            <div class=":uno: flex gap-1 items-center">
              <div class="i-mdi-tag" />
              {data.tags.map((v: string) => (
                <span>{v}</span>
              ))}
            </div>
          )}
        </div>
        <p class=":uno: text-sm text-neutral-300 mt-4">{data.excerpt}</p>
      </a>
    ))
  }
</ArchiveLayout>
