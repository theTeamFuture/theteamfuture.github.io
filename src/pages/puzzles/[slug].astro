---
import type { GetStaticPaths } from "astro";
import { puzzles } from "@/utils/meta.server";
import { render } from "astro:content";

// --- Layouts ---
import PostLayout from "@/layouts/PostLayout.astro";

// --- Export path function ---
export const getStaticPaths = (() =>
  puzzles.map((v) => {
    if (!/^(?!page$)[\da-zA-Z-]+$/.test(v.data.slug)) {
      throw Error("Slug invalid: " + v.data.slug);
    }
    return {
      params: { slug: v.data.slug },
      props: { puzzle: v },
    };
  })) satisfies GetStaticPaths;

// --- Injects ---
const { puzzle } = Astro.props;

// --- Contants ---
const { Content } = await render(puzzle);
---

<PostLayout
  menuUrl="/puzzles"
  title={puzzle.data.title}
  date={puzzle.data.published_at}
>
  {
    puzzle.data.report ? (
      <a
        class=":uno: text-2xl text-neutral-700 font-bold my-8 flex gap-4 select-none transition-color items-center self-center justify-center hover:text-neutral-400"
        href={puzzle.data.report}
      >
        <div class=":uno: i-mdi-box-variant text-5xl" />
        <span>Solved</span>
      </a>
    ) : (
      <div class=":uno: my-8 flex gap-4 select-none items-center justify-center">
        <div class=":uno: i-mdi-box-variant-closed text-5xl text-neutral-500" />
        <p class=":uno: text-2xl text-neutral-500 font-bold">Mystery</p>
      </div>
    )
  }
  <div
    class=":uno: text-sm text-neutral-800 font-bold text-center border-b-2 border-neutral-800 border-dashed select-none"
  >
    Start of Puzzle
  </div>
  <article class=":uno: my-8 prose prose-invert max-w-unset!">
    <Content />
  </article>
  <div
    class=":uno: text-sm text-neutral-800 font-bold mb-auto text-center border-t-2 border-neutral-800 border-dashed select-none"
  >
    End of Puzzle
  </div>
</PostLayout>
